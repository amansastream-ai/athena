{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "index.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,docs/**,var/**,media/**,ops/**,scripts/**,migrations/**,**/__pycache__/**,**/*.pyc,*.md,.env*,Dockerfile,docker-compose.yml,Makefile,alembic.ini,pytest.ini,*.db}"
    },
    "app/main.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,docs/**,var/**,media/**,ops/**,scripts/**,migrations/**,**/__pycache__/**,**/*.pyc,*.md,.env*,Dockerfile,docker-compose.yml,Makefile,alembic.ini,pytest.ini,*.db}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}

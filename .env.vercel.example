# ============================================================================
# VARIABLES A COLLER DANS LE DASHBOARD VERCEL (Settings > Environment Variables)
# Ne mettez AUCUNE valeur reelle dans ce fichier ; il sert de liste de controle.
# Cochez Production + Preview + Development selon vos besoins.
# ============================================================================

# --- OBLIGATOIRES ------------------------------------------------------------
JAAY_ENV=production
JAAY_SECRET_KEY=                      # 64 caracteres hex : python3 -c "import secrets; print(secrets.token_hex(32))"
JAAY_DATABASE_URL=                    # postgresql+psycopg2://user:pwd@host/db?sslmode=require  (Neon / Supabase)
JAAY_PUBLIC_BASE_URL=https://VOTRE-PROJET.vercel.app
JAAY_COOKIE_SECURE=1
JAAY_DEV_SHOW_OTP=0

# --- DEMARRAGE ---------------------------------------------------------------
JAAY_DEMO_MODE=1                      # 1 = comptes démo (METTRE 0 pour un vrai commerce)
JAAY_AUTO_INIT_DB=1                   # 1 au 1er deploiement, puis 0 + Alembic

# --- PHOTOS PRODUITS (sinon les uploads echouent sur Vercel) -----------------
JAAY_MEDIA_BACKEND=s3
JAAY_S3_BUCKET=
JAAY_S3_ENDPOINT=                     # ex : https://xxxxxxxx.r2.cloudflarestorage.com
JAAY_S3_REGION=auto
JAAY_S3_ACCESS_KEY=
JAAY_S3_SECRET_KEY=
JAAY_S3_PUBLIC_BASE_URL=              # domaine public du bucket (ou R2.dev / CDN)
JAAY_S3_ACL=                          # vide sur Cloudflare R2

# --- OPTIONNELS (integrations NON actives sans compte marchand) --------------
JAAY_ADMIN_EMAIL=
SMS_API_URL=
SMS_API_KEY=
WAVE_MODE=off
OM_MODE=off
WA_CLOUD_TOKEN=
AI_API_KEY=

# --- NE JAMAIS METTRE DANS VERCEL --------------------------------------------
# .env, var/*.db, media/* et les cles de test ne doivent pas etre deployes.
# Vercel injecte automatiquement VERCEL=1 : l'application refusera SQLite.

# ============================================================================
# JAAY — exemple de configuration. COPIER vers .env (jamais commité).
# Aucune valeur ci-dessous n'est un secret réel.
# ============================================================================

# --- Application -------------------------------------------------------------
JAAY_ENV=dev                          # dev | test | staging | production
JAAY_DEBUG=0
JAAY_SECRET_KEY=                      # OBLIGATOIRE en production : 32+ octets aléatoires (openssl rand -hex 32)
JAAY_PUBLIC_BASE_URL=https://exemple.sn
JAAY_DATABASE_URL=sqlite:///var/jaay.db
# Production / Vercel : postgresql+psycopg2://user:password@host/db?sslmode=require
# (postgres:// et postgresql:// sont automatiquement convertis)
JAAY_MEDIA_DIR=./media
JAAY_MEDIA_BACKEND=local             # local (VPS) | s3 (OBLIGATOIRE pour les uploads sur Vercel)
JAAY_MAX_UPLOAD_MB=5
JAAY_COOKIE_SECURE=1                 # 1 en production (HTTPS)
JAAY_SESSION_TTL_HOURS=168
JAAY_LOGIN_MAX_ATTEMPTS=5
JAAY_RATE_LIMIT_PER_MINUTE=60
JAAY_DEV_SHOW_OTP=1                  # 0 OBLIGATOIRE en production (code jamais affiché)

# --- Options Vercel / serverless ---------------------------------------------
JAAY_DEMO_MODE=                      # 1 = comptes démo + données de démo (DÉCONSEILLÉ en prod réelle)
JAAY_AUTO_INIT_DB=1                  # 1 = crée le schéma au premier démarrage ; 0 = Alembic uniquement

# --- Stockage objet (photos produits sur Vercel) -----------------------------
JAAY_S3_BUCKET=
JAAY_S3_ENDPOINT=                    # ex : https://<accountid>.r2.cloudflarestorage.com
JAAY_S3_REGION=auto
JAAY_S3_ACCESS_KEY=
JAAY_S3_SECRET_KEY=
JAAY_S3_PUBLIC_BASE_URL=             # URL publique du bucket (CDN / domaine R2)
JAAY_S3_ACL=                         # laisser VIDE sur Cloudflare R2

# --- Amorçage du premier administrateur (à supprimer après usage) -----------
JAAY_BOOTSTRAP_ADMIN_EMAIL=
JAAY_BOOTSTRAP_ADMIN_PASSWORD=
JAAY_BOOTSTRAP_ADMIN_PHONE=

# --- Wave Business Checkout (inactif tant que le compte marchand n'existe pas)
WAVE_MODE=off                        # off | sandbox | live
WAVE_API_KEY=
WAVE_SIGNING_SECRET=                 # signature des requêtes sortantes
WAVE_WEBHOOK_SECRET=                 # vérification des webhooks entrants
WAVE_BASE_URL=https://api.wave.com
WAVE_AGGREGATED_MERCHANT_ID=         # sous-marchand (API Aggregated Merchants)

# --- Orange Money Web Payment (URLs à confirmer sur le portail Sonatel) -----
OM_MODE=off                          # off | sandbox | live
OM_CLIENT_ID=
OM_CLIENT_SECRET=
OM_MERCHANT_KEY=
OM_TOKEN_URL=
OM_WEBPAYMENT_URL=
OM_STATUS_URL=                       # OBLIGATOIRE : vérification serveur (fail-closed)
OM_WEBHOOK_SECRET=
OM_WEBHOOK_SIGNATURE_HEADER=x-om-signature

# --- WhatsApp Business Platform / Cloud API (optionnel) --------------------
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_APP_SECRET=
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_API_URL=https://graph.facebook.com/v21.0

# --- SMS / OTP ---------------------------------------------------------------
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=JAAY

# --- Email et alertes administrateur ----------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
JAAY_ADMIN_EMAIL=
JAAY_ALERT_WEBHOOK_URL=

# --- Assistance IA (facultatif ; mode local déterministe sans clé) ----------
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# --- PostgreSQL (docker compose) --------------------------------------------
POSTGRES_USER=jaay
POSTGRES_PASSWORD=CHANGER_MOI
POSTGRES_DB=jaay

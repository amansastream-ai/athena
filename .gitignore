# Secrets : ne JAMAIS versionner .env (garder les deux modeles uniquement)
.env
.env.*
!.env.example
!.env.vercel.example

# Donnees locales et sauvegardes
var/*
!var/.gitkeep
var/*.db
var/*.db-wal
var/*.db-shm
var/*.db-journal
var/*.sqlite
var/*.sqlite3
var/*.sql
var/dev_secret.key
media/*
!media/.gitkeep

# Cles et certificats (au cas ou)
*.pem
*.key
*.p12
*.pfx

# Outils / caches
.vercel/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.coverage
htmlcov/
*.log
.DS_Store
